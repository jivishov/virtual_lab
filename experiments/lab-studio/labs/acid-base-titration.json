{
  "id": "acid-base-titration",
  "title": "Acid-Base Titration",
  "description": "A schema-authored titration lab where students standardize evidence by measuring an acid aliquot, dispensing base from a burette, confirming the endpoint, and calculating analyte molarity.",
  "audience": "General chemistry students",
  "learningGoals": [
    "Prepare a titration setup with measured analyte and indicator.",
    "Use burette readings to determine delivered titrant volume.",
    "Calculate acid molarity from schema-recorded evidence."
  ],
  "safetyNotes": [
    "Wear goggles and gloves when handling acid, base, and indicator.",
    "Keep the burette clamped upright and clean spills immediately.",
    "Neutralize and dispose of titration waste according to local guidance."
  ],
